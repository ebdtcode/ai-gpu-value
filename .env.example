# Supabase Configuration
# Get these from your Supabase project settings
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (KEEP SECRET - for scripts only, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Configuration
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Email Service (Resend.com for price alerts)
# RESEND_API_KEY=your-resend-api-key

# Analytics (already in BaseLayout.astro, but can override here)
# PUBLIC_GA_TRACKING_ID_AIGPUVALUE=G-3ZJBV421MY
# PUBLIC_GA_TRACKING_ID_LOCALAIGPU=G-DTWED5154S

# Development
NODE_ENV=development
