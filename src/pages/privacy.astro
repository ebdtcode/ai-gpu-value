---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = 'November 2025';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for AIGPUValue.com - how we collect, use, and protect your data."
  currentPath="/privacy"
>
  <article class="privacy-page">
    <div class="container container--narrow">
      <h1>Privacy Policy</h1>
      <p class="last-updated">Last updated: {lastUpdated}</p>

      <section class="privacy-section">
        <h2>Introduction</h2>
        <p>
          AIGPUValue.com ("we," "our," or "us") respects your privacy and is committed to protecting your personal data. This privacy policy explains how we collect, use, and safeguard your information when you visit our website.
        </p>
      </section>

      <section class="privacy-section">
        <h2>Information We Collect</h2>

        <h3>Information You Provide</h3>
        <ul>
          <li><strong>Email Address:</strong> If you subscribe to our newsletter or price alerts</li>
          <li><strong>Contact Information:</strong> If you contact us via email</li>
        </ul>

        <h3>Information Collected Automatically</h3>
        <ul>
          <li><strong>Usage Data:</strong> Pages visited, time spent, click patterns</li>
          <li><strong>Device Information:</strong> Browser type, operating system, screen resolution</li>
          <li><strong>IP Address:</strong> Used for analytics and security purposes</li>
          <li><strong>Cookies:</strong> Small files stored on your device (see Cookie Policy below)</li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>How We Use Your Information</h2>
        <ul>
          <li>To provide and maintain our GPU comparison service</li>
          <li>To send you price alerts and newsletters (if subscribed)</li>
          <li>To analyze usage patterns and improve our website</li>
          <li>To detect and prevent fraud or abuse</li>
          <li>To comply with legal obligations</li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>Cookie Policy</h2>
        <p>We use the following types of cookies:</p>

        <h3>Essential Cookies</h3>
        <p>Required for the website to function properly. These cannot be disabled.</p>
        <ul>
          <li><strong>Theme preference:</strong> Remembers your light/dark mode choice</li>
          <li><strong>View preference:</strong> Remembers your table/card view choice</li>
        </ul>

        <h3>Analytics Cookies</h3>
        <p>Help us understand how visitors use our website.</p>
        <ul>
          <li><strong>Cloudflare Web Analytics:</strong> Privacy-focused analytics that doesn't use cookies or track personal data</li>
        </ul>

        <h3>Third-Party Cookies</h3>
        <p>Set by our partners when you click affiliate links:</p>
        <ul>
          <li>Amazon Associates</li>
          <li>eBay Partner Network</li>
          <li>Newegg Affiliate Program</li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>Affiliate Links</h2>
        <p>
          Our website contains affiliate links to third-party retailers. When you click these links and make a purchase, we may earn a commission. These retailers have their own privacy policies governing how they collect and use your data.
        </p>
        <p>
          We recommend reviewing the privacy policies of:
        </p>
        <ul>
          <li><a href="https://www.amazon.com/privacy" target="_blank" rel="noopener">Amazon Privacy Policy</a></li>
          <li><a href="https://www.ebay.com/help/policies/member-behaviour-policies/user-privacy-notice-privacy-policy" target="_blank" rel="noopener">eBay Privacy Policy</a></li>
          <li><a href="https://www.newegg.com/policy?name=privacy-policy" target="_blank" rel="noopener">Newegg Privacy Policy</a></li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>Data Retention</h2>
        <p>
          We retain your personal data only for as long as necessary to fulfill the purposes outlined in this policy:
        </p>
        <ul>
          <li><strong>Email subscriptions:</strong> Until you unsubscribe</li>
          <li><strong>Analytics data:</strong> 90 days</li>
          <li><strong>Contact inquiries:</strong> 2 years</li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>Your Rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li>Access the personal data we hold about you</li>
          <li>Request correction of inaccurate data</li>
          <li>Request deletion of your data</li>
          <li>Opt out of marketing communications</li>
          <li>Object to processing of your data</li>
        </ul>
        <p>
          To exercise these rights, please contact us at <a href="mailto:privacy@aigpuvalue.com">privacy@aigpuvalue.com</a>.
        </p>
      </section>

      <section class="privacy-section">
        <h2>Data Security</h2>
        <p>
          We implement appropriate technical and organizational measures to protect your personal data, including:
        </p>
        <ul>
          <li>HTTPS encryption for all data transmission</li>
          <li>Secure hosting on Cloudflare's infrastructure</li>
          <li>Limited access to personal data on a need-to-know basis</li>
          <li>Regular security reviews</li>
        </ul>
      </section>

      <section class="privacy-section">
        <h2>Children's Privacy</h2>
        <p>
          Our website is not intended for children under 13 years of age. We do not knowingly collect personal information from children.
        </p>
      </section>

      <section class="privacy-section">
        <h2>Changes to This Policy</h2>
        <p>
          We may update this privacy policy from time to time. We will notify you of any changes by posting the new policy on this page and updating the "Last updated" date.
        </p>
      </section>

      <section class="privacy-section">
        <h2>Contact Us</h2>
        <p>
          If you have questions about this privacy policy, please contact us:
        </p>
        <p>
          Email: <a href="mailto:privacy@aigpuvalue.com">privacy@aigpuvalue.com</a>
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .privacy-page {
    padding: var(--spacing-8) 0 var(--spacing-16);
  }

  .container--narrow {
    max-width: 720px;
  }

  .privacy-page h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 var(--spacing-2);
    color: var(--text-primary);
  }

  .last-updated {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0 0 var(--spacing-8);
  }

  .privacy-section {
    margin-bottom: var(--spacing-8);
  }

  .privacy-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-4);
    color: var(--text-primary);
  }

  .privacy-section h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: var(--spacing-4) 0 var(--spacing-2);
    color: var(--text-primary);
  }

  .privacy-section p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--spacing-4);
  }

  .privacy-section ul {
    color: var(--text-secondary);
    line-height: 1.7;
    padding-left: var(--spacing-6);
    margin: 0 0 var(--spacing-4);
  }

  .privacy-section li {
    margin-bottom: var(--spacing-2);
  }

  .privacy-section strong {
    color: var(--text-primary);
  }

  .privacy-section a {
    color: var(--brand-primary);
    text-decoration: none;
  }

  .privacy-section a:hover {
    text-decoration: underline;
  }
</style>
