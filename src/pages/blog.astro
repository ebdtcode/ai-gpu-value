---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Blog"
  description="AI GPU news, tutorials, and insights - stay up to date with the latest in GPU technology for AI and machine learning workloads."
  currentPath="/blog"
>
  <section class="blog-page">
    <div class="container">
      <header class="blog-header">
        <h1>Blog</h1>
        <p class="blog-intro">
          News, insights, and deep dives into GPU technology for AI workloads. Coming soon.
        </p>
      </header>

      <div class="coming-soon">
        <div class="coming-soon__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8v4l3 3"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
        </div>
        <h2>Coming Soon</h2>
        <p>
          We're working on bringing you the latest news, tutorials, and insights about GPUs for AI workloads. In the meantime, check out our guides for in-depth articles.
        </p>
        <a href="/guides" class="cta-button">Browse Guides</a>
      </div>

      <section class="blog-preview">
        <h2>What to Expect</h2>
        <div class="preview-grid">
          <div class="preview-card">
            <div class="preview-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9"/>
                <path d="M4 4a16 16 0 0 1 16 16"/>
                <circle cx="5" cy="19" r="1"/>
              </svg>
            </div>
            <h3>GPU News</h3>
            <p>Latest releases, driver updates, and industry announcements that matter for AI users.</p>
          </div>

          <div class="preview-card">
            <div class="preview-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"/>
                <path d="m19 9-5 5-4-4-3 3"/>
              </svg>
            </div>
            <h3>Benchmark Analysis</h3>
            <p>Deep dives into new GPU performance data for Stable Diffusion, LLMs, and more.</p>
          </div>

          <div class="preview-card">
            <div class="preview-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
              </svg>
            </div>
            <h3>Buying Advice</h3>
            <p>Market trends, deal alerts, and recommendations based on current pricing.</p>
          </div>

          <div class="preview-card">
            <div class="preview-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14,2 14,8 20,8"/>
                <line x1="16" x2="8" y1="13" y2="13"/>
                <line x1="16" x2="8" y1="17" y2="17"/>
                <line x1="10" x2="8" y1="9" y2="9"/>
              </svg>
            </div>
            <h3>Tutorials</h3>
            <p>Step-by-step guides for optimizing your AI workflow and getting the most from your GPU.</p>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding: var(--spacing-8) 0 var(--spacing-16);
  }

  .blog-header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .blog-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 var(--spacing-4);
    color: var(--text-primary);
  }

  .blog-intro {
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .coming-soon {
    text-align: center;
    padding: var(--spacing-12) var(--spacing-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-12);
  }

  .coming-soon__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: var(--bg-tertiary);
    color: var(--brand-primary);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-6);
  }

  .coming-soon h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-4);
    color: var(--text-primary);
  }

  .coming-soon p {
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto var(--spacing-6);
    line-height: 1.7;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-6);
    background: var(--brand-primary);
    color: white;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color 0.2s ease;
  }

  .cta-button:hover {
    background: var(--brand-hover);
  }

  .blog-preview h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-6);
    color: var(--text-primary);
    text-align: center;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-6);
  }

  .preview-card {
    padding: var(--spacing-6);
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
  }

  .preview-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--bg-tertiary);
    color: var(--brand-primary);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-4);
  }

  .preview-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-2);
    color: var(--text-primary);
  }

  .preview-card p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
