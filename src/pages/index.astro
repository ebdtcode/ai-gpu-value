---
import BaseLayout from '../layouts/BaseLayout.astro';
import GPUList from '../components/GPUList';
import { getAllGPUs } from '../lib/supabase';

// Fetch GPU data from Supabase (falls back to sample data if not configured)
const gpuData = await getAllGPUs();

// JSON-LD structured data for homepage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AIGPUValue',
  url: 'https://aigpuvalue.com',
  description: 'Find the best GPU value for AI workloads. Compare Stable Diffusion, LLM inference performance, and real-time prices.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://aigpuvalue.com/?search={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
  publisher: {
    '@type': 'Organization',
    name: 'AIGPUValue',
    logo: {
      '@type': 'ImageObject',
      url: 'https://aigpuvalue.com/favicon.svg',
    },
  },
};
---

<BaseLayout title="Home" jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">
        Find the Best GPU Value for <span class="hero__highlight">AI</span>
      </h1>
      <p class="hero__subtitle">
        Compare Stable Diffusion, LLM inference performance, and real-time prices.
        Get the most performance per dollar for your AI workloads.
      </p>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">{gpuData.length}+</span>
          <span class="hero__stat-label">GPUs Compared</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">5</span>
          <span class="hero__stat-label">AI Benchmarks</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">4</span>
          <span class="hero__stat-label">Retailers Tracked</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="main-content">
    <div class="container">
      <GPUList client:load gpus={gpuData} />

      <!-- Results Info -->
      <div class="results-info">
        <p class="results-info__update">
          Prices updated: {new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <h2 class="features__title">Why AIGPUValue?</h2>
      <div class="features__grid">
        <div class="feature">
          <div class="feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          </div>
          <h3 class="feature__title">AI-Focused Benchmarks</h3>
          <p class="feature__description">
            Real performance data for Stable Diffusion, SDXL, Flux, and LLM inference - not just gaming benchmarks.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </div>
          <h3 class="feature__title">Real-Time Prices</h3>
          <p class="feature__description">
            Track prices from Amazon, eBay, Newegg, and more. Find the best deals on new and used GPUs.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
          <h3 class="feature__title">Value Scores</h3>
          <p class="feature__description">
            Our algorithm calculates performance per dollar so you can find the best value for your budget.
          </p>
        </div>
        <div class="feature">
          <div class="feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <line x1="3" y1="9" x2="21" y2="9" />
              <line x1="9" y1="21" x2="9" y2="9" />
            </svg>
          </div>
          <h3 class="feature__title">Side-by-Side Compare</h3>
          <p class="feature__description">
            Compare up to 4 GPUs head-to-head with detailed specs and benchmark comparisons.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    padding: var(--spacing-12) 0;
    text-align: center;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--brand-primary) 5%, var(--bg-primary)),
      var(--bg-primary)
    );
  }

  .hero__title {
    font-size: clamp(1.875rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 var(--spacing-4);
    color: var(--text-primary);
  }

  .hero__highlight {
    color: var(--brand-primary);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto var(--spacing-8);
    line-height: 1.6;
  }

  .hero__stats {
    display: flex;
    justify-content: center;
    gap: var(--spacing-8);
    flex-wrap: wrap;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .hero__stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-primary);
    font-family: var(--font-mono);
  }

  .hero__stat-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Main Content */
  .main-content {
    padding: var(--spacing-8) 0;
  }

  .results-info {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: var(--spacing-4);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--border-default);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .results-info__update {
    font-size: 0.75rem;
  }

  /* Features Section */
  .features {
    padding: var(--spacing-16) 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-default);
  }

  .features__title {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 var(--spacing-8);
    color: var(--text-primary);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-6);
  }

  .feature {
    text-align: center;
    padding: var(--spacing-6);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    transition: all 0.15s ease;
  }

  .feature:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-md);
  }

  .feature__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: color-mix(in srgb, var(--brand-primary) 10%, transparent);
    color: var(--brand-primary);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-4);
  }

  .feature__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-2);
    color: var(--text-primary);
  }

  .feature__description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }
</style>
