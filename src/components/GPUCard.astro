---
import type { GPUWithData, ValueRating } from '../types';
import { getValueRating, formatPrice, formatNumber } from '../types';

interface Props {
  gpu: GPUWithData;
}

const { gpu } = Astro.props;

const valueRating = getValueRating(gpu.valueScore);
const brandClass = gpu.brand.toLowerCase();

// Get the best price
const bestNewPrice = gpu.lowestNewPrice;
const bestUsedPrice = gpu.lowestUsedPrice;
const displayPrice = bestUsedPrice || bestNewPrice;

// Performance metrics
const sdxlPerf = gpu.benchmarks?.sdxlImgsPerMin;
const llmPerf = gpu.benchmarks?.llm7bTokensPerSec;
---

<article class="gpu-card card">
  <div class="gpu-card__header">
    <span class={`gpu-brand gpu-brand--${brandClass}`}>
      {gpu.brand}
    </span>
    <span class={`value-badge value-badge--${valueRating}`}>
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
      </svg>
      {gpu.valueScore}
    </span>
  </div>

  <h3 class="gpu-card__title">
    <a href={`/gpus/${gpu.slug}`}>{gpu.name}</a>
  </h3>

  <div class="gpu-card__specs">
    <div class="gpu-card__spec">
      <span class="gpu-card__spec-label">VRAM</span>
      <span class="gpu-card__spec-value spec-value">{gpu.vramGb}GB {gpu.vramType}</span>
    </div>
    <div class="gpu-card__spec">
      <span class="gpu-card__spec-label">TDP</span>
      <span class="gpu-card__spec-value spec-value">{gpu.tdpWatts}W</span>
    </div>
  </div>

  {(sdxlPerf || llmPerf) && (
    <div class="gpu-card__benchmarks">
      {sdxlPerf && (
        <div class="gpu-card__benchmark">
          <span class="gpu-card__benchmark-label">SDXL</span>
          <span class="gpu-card__benchmark-value spec-value">{sdxlPerf} img/min</span>
        </div>
      )}
      {llmPerf && (
        <div class="gpu-card__benchmark">
          <span class="gpu-card__benchmark-label">LLM 7B</span>
          <span class="gpu-card__benchmark-value spec-value">{llmPerf} tok/s</span>
        </div>
      )}
    </div>
  )}

  <div class="gpu-card__pricing">
    {bestUsedPrice && (
      <div class="gpu-card__price">
        <span class="gpu-card__price-label">Used</span>
        <span class="gpu-card__price-value price">{formatPrice(bestUsedPrice)}</span>
      </div>
    )}
    {bestNewPrice && (
      <div class="gpu-card__price">
        <span class="gpu-card__price-label">New</span>
        <span class="gpu-card__price-value price">{formatPrice(bestNewPrice)}</span>
      </div>
    )}
  </div>

  <a
    href={gpu.prices[0]?.affiliateUrl || `/gpus/${gpu.slug}`}
    class="btn btn--primary gpu-card__cta"
    target={gpu.prices[0]?.affiliateUrl ? '_blank' : undefined}
    rel={gpu.prices[0]?.affiliateUrl ? 'noopener sponsored' : undefined}
  >
    Check Price
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </svg>
  </a>
</article>

<style>
  .gpu-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .gpu-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .gpu-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .gpu-card__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .gpu-card__title a:hover {
    color: var(--brand-primary);
  }

  .gpu-card__specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2);
  }

  .gpu-card__spec {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .gpu-card__spec-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .gpu-card__spec-value {
    color: var(--text-secondary);
  }

  .gpu-card__benchmarks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-2);
    padding: var(--spacing-3);
    background-color: var(--bg-tertiary);
    border-radius: var(--radius-md);
  }

  .gpu-card__benchmark {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .gpu-card__benchmark-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .gpu-card__benchmark-value {
    color: var(--text-primary);
    font-weight: 500;
  }

  .gpu-card__pricing {
    display: flex;
    gap: var(--spacing-4);
    margin-top: auto;
    padding-top: var(--spacing-3);
    border-top: 1px solid var(--border-default);
  }

  .gpu-card__price {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .gpu-card__price-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .gpu-card__price-value {
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .gpu-card__cta {
    width: 100%;
    margin-top: var(--spacing-2);
  }
</style>
